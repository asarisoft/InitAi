# ==============================================================================
# InitAI Backend Environment Variables & Multi-Provider LLM Configuration
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000

# ------------------------------------------------------------------------------
# LLM Provider Selection
# ------------------------------------------------------------------------------
# Options: 'auto' (detects Gemini first, then OpenAI, then Local), 'gemini', 'openai'
LLM_PROVIDER=auto

# ------------------------------------------------------------------------------
# 1. Google Gemini LLM Settings (Free Tier: 15 RPM, 1M tokens/day)
# ------------------------------------------------------------------------------
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TEMPERATURE=0.7
GEMINI_TOP_P=0.95
GEMINI_MAX_OUTPUT_TOKENS=4096

# ------------------------------------------------------------------------------
# 2. OpenAI LLM Settings (GPT-4o, GPT-4o-mini, o3-mini, Custom Base URLs)
# ------------------------------------------------------------------------------
# Get your key at: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1 # Optional: Custom endpoint (e.g. OpenRouter, Ollama, Azure)
OPENAI_TEMPERATURE=0.7
OPENAI_MAX_TOKENS=4096

# ------------------------------------------------------------------------------
# Security & Networking
# ------------------------------------------------------------------------------
# CORS Allowed Origins (comma-separated or *)
CORS_ORIGINS=*
