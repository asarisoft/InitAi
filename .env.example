# ==============================================================================
# InitAI Backend Environment Variables
# ==============================================================================

# Server Configuration
HOST=0.0.0.0
PORT=8000

# Google Gemini API Key (Optional)
# If provided, the backend enables real-time Gemini Function/Tool Calling.
# If empty or not set, InitAI runs gracefully on its built-in Intelligent Local Engine.
# Get your free key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# CORS Allowed Origins (comma-separated or *)
CORS_ORIGINS=*
